# Configuración de SerVmax
# Copia este archivo como .env y completa los valores

# Clave secreta de Django (genera una nueva para producción)
SECRET_KEY=django-insecure-cambiar-esta-clave-en-produccion

# API Key de Google Gemini
# Obtén tu API Key en: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=tu-api-key-de-google-gemini-aqui

# Configuración de base de datos (opcional, por defecto usa SQLite)
# DATABASE_URL=sqlite:///db.sqlite3

# Configuración de debug (cambiar a False en producción)
# DEBUG=True
